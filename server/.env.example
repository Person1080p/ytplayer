# Copy to server/.env and adjust. Everything is optional.

# Where to listen. Keep it on localhost and expose it with `tailscale serve`,
# or bind to your tailscale IP (100.x.y.z:8080).
YTP_BIND=127.0.0.1:8080
YTP_DATA_DIR=./data
YTP_WEB_DIR=../web/dist

# External base URL, used for OAuth callbacks (Last.fm, Spotify). Auto-detected from
# request headers when unset, e.g. https://ytp.your-tailnet.ts.net
#YTP_PUBLIC_URL=

# Optional shared secret. The web app asks for it once and stores it as a cookie.
#YTP_ACCESS_TOKEN=

# Last.fm API account: https://www.last.fm/api/account/create (can also be entered in Settings)
#LASTFM_API_KEY=
#LASTFM_API_SECRET=

# ffmpeg for the audio cache (MP3 copies of recent YouTube plays). Found on PATH by default;
# without it the cache is off.
#YTP_FFMPEG=/usr/bin/ffmpeg

# Where the managed yt-dlp is kept (default: <YTP_DATA_DIR>/bin). Put it on a local disk if the
# data dir is on a network share: yt-dlp is read in full every time it runs.
#YTP_BIN_DIR=

# A browser for this server that's used through a web page (e.g. the Firefox container in
# docker-compose.yml). Settings → YouTube Music then opens it for "Sign in with Google".
#YTP_SIGNIN_BROWSER_URL=https://my-nas.local:5800

# Use a specific yt-dlp binary instead of the managed/auto-downloaded one.
#YTDLP_PATH=/usr/local/bin/yt-dlp

# Built-in Tailscale node (on by default; the server joins your tailnet as TS_HOSTNAME and
# shows its sign-in link in Settings → Connection). Set TS_EMBEDDED=0 to turn it off.
#TS_EMBEDDED=0
#TS_HOSTNAME=ytp
#TS_AUTHKEY=tskey-auth-...
#TS_STATE_DIR=./data/tailscale
# Fixed UDP port for the built-in node (default: any free port). Publish it from a container (and
# optionally forward it on the router) so devices connect directly instead of via Tailscale's relays.
#TS_PORT=41641

RUST_LOG=ytp_server=info,tower_http=warn
